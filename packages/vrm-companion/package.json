{
  "name": "@botharness/vrm-companion",
  "version": "0.0.0",
  "private": true,
  "description": "Independent native VRM companion Panel",
  "files": [
    "dist",
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mochiya/three-liltoon": "0.1.9",
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@botharness/ui": "link:../client",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@types/react": "~18.3.1",
    "@types/three": "0.180.0",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
