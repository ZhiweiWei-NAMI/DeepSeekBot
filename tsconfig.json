{
  "compilerOptions": {
    "target": "ES2023",
    "paths": { "@botharness/ui/panels": ["./packages/client/src/panel-api.ts"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // Ordered on purpose: the client's session-store declaration must be
  // processed before host packages that import `@deepseek-ai/dsh-agent`.
  // Both augment `ctx.sessions` with different `list` types; the first
  // declaration in program order wins, and an alphabetical `packages/*/src`
  // put `packages/browser` first, which made `ctx.sessions.list` lose its
  // store methods in `packages/client`.
  "include": [
    "packages/client/src",
    "packages/computer/src",
    "packages/vrm-companion/src",
    "packages/core/src",
    "packages/deepseekbot/src",
    "packages/browser/src",
    "packages/todo/src",
    "packages/market/src",
    "packages/ingest/src",
    "packages/links/src",
    "packages/links-cli/src",
    "packages/connect-relay/src",
    "packages/*/test",
    "apps/mobile/test",
    "*.config.ts"
  ],
  "exclude": [
    "apps/mobile/test/posthog-sender.test.ts",
    "apps/mobile/test/native-telemetry.test.ts",
    "apps/mobile/test/native-persistence.test.ts",
    "apps/mobile/test/native-chat-background.test.ts",
    "apps/mobile/test/inbox-screens.test.ts",
    "apps/mobile/test/action-cards.test.ts",
    "apps/mobile/test/activity-feed.test.ts",
    "apps/mobile/test/open-conversation.test.ts",
    "apps/mobile/test/quick-action-routing.test.ts",
    "apps/mobile/test/incoming-share.test.ts",
    "apps/mobile/test/grant-request-card.test.ts",
    "apps/mobile/test/attention-actions.test.ts",
    "apps/mobile/test/reanimated-shim.ts",
    "apps/mobile/test/**/*.tsx"
  ]
}
